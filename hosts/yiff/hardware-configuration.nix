{
  config,
  lib,
  pkgs,
  modulesPath,
  ...
}:

{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot.initrd.availableKernelModules = [
    "xhci_pci"
    "ahci"
    "nvme"
    "usbhid"
    "usb_storage"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-intel" ];
  boot.extraModulePackages = [ ];

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/0e55a32f-87c0-4584-96d3-ed610a35a091";
    fsType = "ext4";
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/52E3-DA1B";
    fsType = "vfat";
    options = [
      "fmask=0077"
      "dmask=0077"
    ];
  };

  fileSystems."/mnt/clip-archive" = {
    device = "192.168.1.69:/mnt/user/clip-archive";
    fsType = "nfs";
    options = [
      "x-systemd.automount"
      "noauto"
      "x-gvfs-show"
    ];
  };

  fileSystems."/mnt/ext-storage" = {
    device = "/dev/disk/by-uuid/467e47be-97d9-4a9f-8921-85fd6eedcd3c";
    fsType = "btrfs";
    options = [
      "subvol=ext-storage"
      "compress=zstd"
      "x-gvfs-show"
      "noatime"
    ];
  };

  swapDevices = [
    { device = "/dev/disk/by-uuid/0336a9f3-b505-4759-a6a7-ba9db183c7f8"; }
  ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
