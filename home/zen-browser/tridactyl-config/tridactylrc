" vim: filetype=vim
" will wipe all settings every source, settings things back to defaults
sanitize tridactyllocal tridactylsync


" general settings -----------------
set hintchars arstgmneio
set hintstyles.fg none
set hintfiltermode vimperator-reflow
set smoothscroll true
set editorcmd foot nvim 
set allowautofocus true
set browser zen
set externalclipboardcmd wl-copy
set escapehatchsidebarhack false " stops it from closing sideberry
set completions.Tab.statusstylepretty true 
set completions.History.autoselect false
set modeindicatorshowlastex true
" theme :3
" they need 2 go in .config/tridactyl/themes
colorscheme gruvbox-new

setnull searchurls.twitter
setnull searchurls.youtube
setnull searchurls.google
setnull searchurls.amazon
set searchurls.!a https://www.amazon.co.uk/s/ref=nb_sb_noss?url=search-alias%3Daps&field-keywords=
set searchurls.!yt https://www.youtube.com/results?search_query=
set searchurls.!g https://www.google.com/search?udm=14&q=
set searchurlweight 10

" binds-----------------------------
" misc
bind ,<Space> nohlsearch " clear search
bind ,s source
" tab stuff i guess
bind s fillcmdline open
bind S current_url open
bind D tabdetach

" let me use normal things with ex pleaseee :(
"bind --mode=ex <ArrowDown> ex.next_completion
"bind --mode=ex <ArrowUp> ex.prev_completion
"unbind --mode=ex <Space>

" rebinds for colemak
unbind j
unbind k
unbind h
unbind l
unbind J
unbind K
unbind L
unbind H

"bind n scrollpx -50
bind e scrollline 5
bind i scrollline -5
"bind o scrollpx 50

bind gn back
bind ge tabnext
bind gi tabprev
bind go forward

bind / fillcmdline find
bind h findnext
bind H findnext --reverse

bind m scrollpage -0.3
bind k scrollpage 0.3

unbind <C-e>
unbind <C-b>
unbind <C-h>

"hinting
bind ;? winopen moz-extension://cac12804-920b-45a3-80ab-3422327293b4/static/docs/modules/_src_excmds_.html#hint
